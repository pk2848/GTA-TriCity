  "howToAddMoreVehicles": {
    "steps": [
      "Copy the new .glb into public/models/vehicles/",
      "Add an entry to the vehicles array with id, brand, model, displayName, file, scale, rotation and physics",
      "Use physics.vehicleType='motorcycle', 'helicopter' or 'boat' for the relevant controls and sound profile",
      "Refresh the game; the top-right garage reads this manifest automatically"
    ],
    "note": "The model itself must have a Y-up game orientation after the supplied rotation. Add wheelGroupPattern only when the GLB has separately named wheel meshes."
  }
